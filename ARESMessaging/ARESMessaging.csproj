<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Authentication.proto" />
    <None Remove="DeviceStateLogging\DevicesResponse.proto" />
    <None Remove="DeviceStateLogging\MfcStateLogging.proto" />
    <None Remove="DeviceState\StateExportService.proto" />
    <None Remove="DeviceState\StateRequestFilter.proto" />
    <None Remove="MfcState.proto" />
    <None Remove="SerialConnectivity.proto" />
    <None Remove="UserManagement.proto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.31.1" />
    <PackageReference Include="Grpc" Version="2.46.6" />
    <PackageReference Include="Grpc.Tools" Version="2.72.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

	<ItemGroup>
    <Protobuf Include="DeviceStateLogging\DevicesResponse.proto" GrpcServices="None" />

    <Protobuf Include="DeviceState\StateRequestFilter.proto" GrpcServices="None" />
    
    <Protobuf Include="DeviceState\StateExportService.proto" />
    <Protobuf Include="SerialConnectivity.proto" />
    <Protobuf Include="UserManagement.proto" />
    <Protobuf Include="Authentication.proto" />
  </ItemGroup>

</Project>
