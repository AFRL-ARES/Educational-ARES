M73 P0 R1
M73 Q0 S1
M201 X4000 Y4000 Z200 E2500 ; sets maximum accelerations, mm/sec^2
M203 X300 Y300 Z40 E100 ; sets maximum feedrates, mm / sec
M204 P4000 R1200 T4000 ; sets acceleration (P, T) and retract acceleration (R), mm/sec^2
M205 X8.00 Y8.00 Z2.00 E10.00 ; sets the jerk limits, mm/sec
M205 S0 T0 ; sets the minimum extruding and travel feed rate, mm/sec

; printing object circle.stl id:2 copy 0
; stop printing object circle.stl id:2 copy 0
; printing object circle.stl id:1 copy 0
; stop printing object circle.stl id:1 copy 0
; printing object circle.stl id:0 copy 0
; stop printing object circle.stl id:0 copy 0

;TYPE:Custom
M17 ; enable steppers
M862.1 P0.4 A0 F1 ; nozzle check
M862.3 P "MK4S" ; printer model check
M862.5 P2 ; g-code level check
M862.6 P"Input shaper" ; FW feature check
M115 U6.2.2+8853

M555 X0.945111 Y5.67986 W142.382 H61.5939

G90 ; use absolute coordinates
M83 ; extruder relative mode

M140 S60 ; set bed temp
M104 T0 S170 ; set extruder temp for bed leveling
M109 T0 R170 ; wait for temp

M84 E ; turn off E motor

G28 ; home all without mesh bed level

G1 X42 Y-4 Z5 F4800

M302 S160 ; lower cold extrusion limit to 160C


G1 E-2 F2400 ; retraction


M84 E ; turn off E motor

G29 P9 X10 Y-4 W32 H4

M106 S100

G0 Z40 F10000

M190 S60 ; wait for bed temp

M107

;
; MBL
;
M84 E ; turn off E motor
G29 P1 ; invalidate mbl & probe print area
G29 P1 X0 Y0 W50 H20 C ; probe near purge place
G29 P3.2 ; interpolate mbl probes
G29 P3.13 ; extrapolate mbl outside probe area
G29 A ; activate mbl

; prepare for purge
M104 S230
G0 X200 Y-4 Z15 F4800 ; move away and ready for the purge
M73 P1 R1
M73 Q1 S1
M109 S230

G92 E0
M569 S0 E ; set spreadcycle mode for extruder

;
; Extrude purge line
;
G92 E0 ; reset extruder position
G1 E2 F2400 ; deretraction after the initial one before nozzle cleaning
M73 P2 R1
M73 Q2 S1
G0 E7 X215 Z0.2 F500 ; purge
G0 X225 E4 F500 ; purge
M73 P4 R1
M73 Q4 S1
G0 X235 E4 F650 ; purge
M73 P5 R1
M73 Q5 S1
G0 X245 E4 F800 ; purge
M73 P6 R1
M73 Q6 S1
G0 X248 Z0.05 F8000 ; wipe, move close to the bed
G0 X251 Z0.2 F8000 ; wipe, move quickly away from the bed

G92 E0
M221 S100 ; set flow to 100%
G21 ; set units to millimeters
G90 ; use absolute coordinates
M83 ; use relative distances for extrusion
M572 S0.036 ; Filament gcode

M142 S36 ; set heatbreak target temp
M107
