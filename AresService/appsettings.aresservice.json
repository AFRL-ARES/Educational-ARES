{
  "TokensConfig": {
    "Issuer": "localhost",
    "Audience": "localhost",
    "Key": "Some private key that is definitely over 128 bits in length"
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=../Data/ares_database.db",
    "Postgres": "Host=localhost;Database=ARES;Username=postgres;Password=postgres",
    "SqlServer": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=ARES;Integrated Security=True;Pooling=False;"
  },
  "DatabaseProvider": "Sqlite",
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Grpc": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/AresService.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "CertificateSettings": {
    "Path": "AresServiceCert.cer",
    "KeyPath": "AresService.key",
    "Password": "SecurePassword"
  },
  "AresDataPath": "../Data"
}
