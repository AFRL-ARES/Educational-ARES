{
  "ConnectionStrings": {
    "Sqlite": "Data Source=../Data/ares_database.db",
    "Postgres": "Host=localhost;Database=ARES;Username=postgres;Password=postgres",
    "SqlServer": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=ARES;Integrated Security=True;Pooling=False;"
  },
  "DatabaseProvider": "Sqlite",
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/AresUi.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] ({SourceContext}) {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "AllowedHosts": "*",
  "RemoteServiceSettings": {
    "ServerHost": "localhost",
    "ServerPort": 5001
  },
  "CertificateSettings": {
    "Path": "AresClientCert.cer",
    "Password": "SecurePassword"
  }
}
