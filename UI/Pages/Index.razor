@page "/"
@using UI.Backend.Devices
@using UI.Backend.Repos
@using UI.Backend.ViewModels
@using UI.Pages.Shared.Devices.CrealityCamera
@using UI.Pages.Shared.Devices.PrusaPrinter
@using UI.Pages.Shared.Misc

@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<IndexViewModel>
@inject IJSRuntime JS
@inject IDeviceControlViewModelRepo ViewModelRepo

<PageTitle>Dashboard</PageTitle>
<div class="d-flex flex-column gap-2">
  <div class="d-flex gap-2">
    <ManualExecutionWidget />
  </div>

  <div class="grid-stack" id="my-dashboard">
      @foreach(var viewModel in ViewModelRepo.Items)
      {
        //Fallback Values
        var width = viewModel.DefaultWidth;
     
        <div class="grid-stack-item" @key="viewModel.DeviceId" gs-w="@width" gs-size-to-content="true">
          <div class="grid-stack-item-content">
            <DashboardWidget>
              <DynamicComponent Type="@viewModel.ViewType" Parameters="@CreateViewArguments(viewModel!)"/>
            </DashboardWidget>
          </div>
        </div>
      }
  </div>

</div>

@code {
  private IJSObjectReference? _module;
  private DotNetObjectReference<Index>? _objRef;

  private Dictionary<string, object> CreateViewArguments(DeviceUnitControlViewModel viewModel) => new Dictionary<string, object>() { { "ViewModel", viewModel } };

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if(firstRender)
    {
      _objRef = DotNetObjectReference.Create(this);
      _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/Index.razor.js");
      await _module.InvokeVoidAsync("initDashboard", "my-dashboard", _objRef);
    }

    else
    {
      if (_module is not null)
      {
        await _module.InvokeVoidAsync("refreshGrid", "my-dashboard");
        await _module.InvokeVoidAsync("resizeToContent", "my-dashboard");
      }
    }
  }

  private void ViewModelsUpdated()
  {
    StateHasChanged();
  }

  protected override void OnInitialized()
  {
    ViewModelRepo.Connect().Subscribe(_ => InvokeAsync(ViewModelsUpdated));
  }

  [JSInvokable]
  public void OnDashboardUpdate(object updates)
  {
    //TODO: Save dashboard changes
    Console.WriteLine("Dashboard Updated vis JS!");
  }

  async ValueTask DisposeAsync()
  {
    if (_module is not null)
    {
      await _module.DisposeAsync();
    }
    _objRef?.Dispose();
  }
}