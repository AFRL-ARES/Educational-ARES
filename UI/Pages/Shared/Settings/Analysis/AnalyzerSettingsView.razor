@using Ares.Services
@using Google.Protobuf.WellKnownTypes
@using UI.Pages.Shared.Settings.Analysis.Layout
@inherits ReactiveUI.Blazor.ReactiveComponentBase<UI.Backend.ViewModels.Settings.Analysis.AnalyzerSettingsViewModel>
@inject DialogService DialogService

<AnalyzerSettingsContainer EditCallback="EditCallback" 
  SettingsCallback="SettingCallback" 
  RemoveCallback="RemoveCallback" 
  StateUpdateCallback="UpdateStateCallback" 
  Name="@ViewModel!.Name" 
  State="@ViewModel!.AnalyzerState" 
  StateMessage="@ViewModel!.StateMessage" 
  UpdatingInProgress="@UpdateInProgress">
  <div style="display: flex; flex-direction: column">
    <span>Address: @ViewModel!.Address</span>
    <span>Type: @ViewModel!.Type</span>
    <span>Version: @ViewModel!.Version</span>
    <span>@ViewModel!.Description</span>
  </div>
</AnalyzerSettingsContainer>

@code {
  public bool UpdateInProgress { get; private set; }
  private async Task EditCallback()
  {
    var viewModel = ViewModel!.EditViewModel;
    var result = await DialogService.OpenAsync("Edit Analyzer", ds =>
      @<AnalyzerConfigEditView ViewModel="@viewModel" OnValidSubmit="() => ds.Close(true)"/>);

    if (result is true && viewModel.Modified)
    {
      await ViewModel!.Save();
      StateHasChanged();
    }
  }

  private async Task RemoveCallback()
  {
    var result = await DialogService.Confirm($"Delete {ViewModel!.Name}?");
    if (result is true)
    {
      await ViewModel!.Remove();
    }
  }

  private async Task SettingCallback()
  {
    var viewModel = ViewModel!.SettingsEditorViewModel;
    var result = await DialogService.OpenAsync("Analyzer Settings", ds =>
    @<AnalyzerSettingsEditorView ViewModel="@viewModel" OnValidSubmit="() => ds.Close(true)"/>);
  
    if(result is true && viewModel!.Modified)
    {
      await ViewModel!.Save();
      StateHasChanged();
      var notification = new AresNotification();
      notification.Message = $"ARES successfully saved the request changes to {ViewModel!.Name}'s settings.";
      notification.Title = "Successfully Updated Analyzer Settings";
      notification.NotificationSeverity = Severity.Success;
      notification.Timestamp = DateTime.UtcNow.ToTimestamp();
      ViewModel!.PushNotification(notification);
    }
  }

  private Task UpdateStateCallback()
  {
    return Update();
  }

  private async Task Update() {
    UpdateInProgress = true;
    await ViewModel!.UpdateState();
    await ViewModel!.UpdateInfo();
    UpdateInProgress = false;
    StateHasChanged();
  }

  protected override async Task OnInitializedAsync()
  {
    await base.OnInitializedAsync();
    _ = Update();
  }
}
