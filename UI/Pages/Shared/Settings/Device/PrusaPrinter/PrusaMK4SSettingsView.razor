@using Ares.Services
@using Google.Protobuf.WellKnownTypes
@inherits ReactiveUI.Blazor.ReactiveComponentBase<UI.Backend.ViewModels.Settings.Device.PrusaMK4S.PrusaMK4SSettingsViewModel>
@inject DialogService DialogService

<DeviceSettingsContainer DeviceStatusGetter="ViewModel!.GetDeviceStatus" EditCallback="EditCallback" RemoveCallback="RemoveCallback" ActivateCallback="ViewModel.Activate" Name="@ViewModel!.MK4SConfig.DeviceName">
  <div>
    @if (ViewModel!.MK4SConfig.Simulated)
    {
      <span> Simulated Prusa MK4S Printer </span>
    }

    <span>@ViewModel!.MK4SConfig.DeviceName</span>
  </div>
</DeviceSettingsContainer>

@code {
	private async Task EditCallback()
  {
    var viewModel = ViewModel!.EditViewModel;
    var result = await DialogService.OpenAsync("Edit Prusa Printer", ds =>
      @<PrusaMK4SConfigEditView ViewModel="@viewModel" OnValidSubmit="() => ds.Close(true)"/>);

    await ViewModel!.Save();
    var notification = new AresNotification();
    notification.Message = $"ARES successfully updated {viewModel.Name}.";
    notification.Title = $"Successfully Updated {viewModel.Name}!";
    notification.NotificationSeverity = Severity.Success;
    notification.Timestamp = DateTime.UtcNow.ToTimestamp();
    ViewModel!.PushNotification(notification);
 
  }

  private async Task RemoveCallback()
  {
    var result = await DialogService.Confirm($"Delete {ViewModel!.MK4SConfig.DeviceName}?");
    if (result is true)
    {
      await ViewModel!.Remove();
    }
  }
}
