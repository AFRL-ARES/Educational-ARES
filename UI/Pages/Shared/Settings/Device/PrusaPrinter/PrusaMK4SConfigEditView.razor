@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Radzen.Blazor
@inherits ReactiveUI.Blazor.ReactiveComponentBase<UI.Backend.ViewModels.Settings.Device.PrusaMK4S.PrusaMK4SConfigEditViewModel>

<EditForm Model="@ViewModel" OnValidSubmit="OnValidSubmit">
  <input type="text" class="form-control" disabled="@(!ViewModel!.NewConfig)" placeholder="Name" @bind="@ViewModel!.Name" />

  <RadzenRow Gap="1rem" Style="padding-top: 0.5rem; padding-bottom: 0.5rem;">
    <RadzenLabel Text="Simulated" Component="simulated-switch" />
    <RadzenSwitch id="simulated-switch" @bind-Value="@ViewModel!.Simulated">Simulated</RadzenSwitch>
  </RadzenRow>

  <RadzenStack Gap="1rem" Orientation="Orientation.Vertical">
    <RadzenFormField Text="Printer Address" Variant="Variant.Flat">
      <RadzenTextBox @bind-Value=ViewModel!.Address />
    </RadzenFormField>

    <RadzenFormField Text="Username" Variant="Variant.Flat">
      <RadzenTextBox @bind-Value=ViewModel!.Username />
    </RadzenFormField>

    <RadzenFormField Text="Password" Variant="Variant.Flat">
      <RadzenTextBox @bind-Value=ViewModel!.Password />
    </RadzenFormField>
  </RadzenStack>

  <ValidationSummary />
  <DataAnnotationsValidator />
  <button type="submit" class="btn my-2 btn-outline-primary">Save</button>
</EditForm>
@code {
  [Parameter]
  public Action OnValidSubmit { get; set; } = delegate
  {
  };
}