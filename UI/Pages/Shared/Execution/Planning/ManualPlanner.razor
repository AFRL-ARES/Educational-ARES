@inherits ReactiveUI.Blazor.ReactiveInjectableComponentBase<UI.Backend.ViewModels.Automation.Planning.ManualPlannerViewModel>
@inject DialogService dialogService

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
  <RadzenButton Click="EditManualPlanClick" ButtonStyle="ButtonStyle.Secondary" Text="Edit Manual Plan" />
  <RadzenButton Click="@DisplayManualPlannerHelpTab" Icon="help" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.ExtraSmall" />
  <RadzenText Text="@($"Number of Planned Items: {ViewModel!.DisplayObjects.Count}")"/>
</RadzenStack>



@code {
  [Parameter]
  public string Name { get; set; } = "Manual Planner";

  [Parameter]
  public string Type { get; set; } = "ManualPlanner";

  [Parameter]
  public Version Version { get; set; } = new (1, 0);

  private async Task EditManualPlanClick()
  {
    await dialogService.OpenAsync<ManualPlanEditor>("Edit Manual Plan");
  }

  private async Task DisplayManualPlannerHelpTab()
  {
    await dialogService.OpenAsync("The Manual Planner", ds =>
    @<div>
      ARES provides a manual planner to give the user a way to feed pre-determined values into an experiment manually.
      The manual planner accepts both strings and numbers as input. Any entries surrounded by quotation marks (e.g. "value") will be parsed as a string,
      otherwise ARES will attempt to parse the entry as a number.
    </div>
    , new DialogOptions() { CloseDialogOnOverlayClick = true });
  }
}
