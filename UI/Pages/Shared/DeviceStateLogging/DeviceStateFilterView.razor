@using Ares.Services
@using UI.Backend.ViewModels.DeviceStateLogging;

@inject AresAutomation.AresAutomationClient AutomationClient

@inherits ReactiveUI.Blazor.ReactiveComponentBase<DeviceStateFilterViewModel>

<div class="filter-grid">
  @if (ViewModel?.AvailableDevices is not null)
  {
    <div class="device-picker">
      <RadzenListBox Placeholder="Devices to Export" Name="Available Devices" Style="width: 100%; max-height: 300px;" Multiple="true" Data=@ViewModel.AvailableDevices @bind-Value="ViewModel.SelectedDevices">
        <Template>
          @context.DeviceName
        </Template>
      </RadzenListBox>
    </div>
  }
  else
  {
    <span class=device-picker>Loading Devices...</span>
  }

  <RadzenLabel class="start-time-label" Text="Start Time Filter" />
  <RadzenCheckBox @bind-Value=ViewModel!.UseStartTime class="start-time-checkbox" />
  <RadzenDatePicker class="start-time-picker" @bind-value=ViewModel.StartTime TValue="DateTime" ShowTime="true" HourFormat="24" DateFormat="MM/dd/yyyy HH:mm" />

  <RadzenLabel class="end-time-label" Text="End Time Filter" />
  <RadzenCheckBox @bind-Value=ViewModel.UseEndTime class="end-time-checkbox" />
  <RadzenDatePicker class="end-time-picker" @bind-value=ViewModel.EndTime TValue="DateTime" ShowTime="true" HourFormat="24" DateFormat="MM/dd/yyyy HH:mm" />

  <RadzenLabel class="interval-label" Text="Export Interval (ms)" />
  <span></span>
  <RadzenNumeric class="interval-picker" Change=IntervalChanged TValue="double" />

  <RadzenLabel class="experiments-label" Text="Experiment Filter" />
  <RadzenCheckBox @bind-Value=ViewModel.UseExperiment class="experiments-checkbox" />


  @if (ViewModel?.Campaigns is not null)
  {
    <RadzenListBox class="experiments-picker" TValue="string" Data=@ViewModel.Campaigns TextProperty="CampaignName" AllowFiltering="true" ValueProperty="SummaryId" Change="@(args => ViewModel.UpdateExperiments(args.ToString()))" />
  }
  else
  {
    <span class="experiments-picker">Loading Campaigns...</span>
  }
</div>
@code {
  private void IntervalChanged(double val)
  {
    ViewModel!.Interval = TimeSpan.FromMilliseconds(val);
  }
}
